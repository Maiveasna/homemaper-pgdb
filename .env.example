POSTGRES_DB=easykit_db
POSTGRES_USER=easykit_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=easykit-postgres
BACKUP_DIR=./backups

# ---------- SQL Server (source) ----------
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD="your!password"
MSSQL_DATABASE=MyDatabase
# MSSQL_CHARSET=UTF-8
# ---------- PostgreSQL (target, schema must already exist) ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD="your!password"
PG_DATABASE=mydb
# PG_SSLMODE=require
# Or use a single connection string instead of the PG_* fields above:
# PG_DSN=postgresql://user:pass@host:5432/dbname
# ---------- Optional behaviour ----------
# Only migrate these SQL Server schemas / tables (comma separated, empty = all)
# MIGRATE_SCHEMAS=dbo,sales
# MIGRATE_TABLES=Users,Orders,sales.Invoices
# SQL Server schema -> PostgreSQL schema (default dbo:public)
SCHEMA_MAP=dbo:public
# Overrides when names differ by more than case/underscores
# TABLE_MAP=Customers:clients,dbo.OrderLines:order_items
# COLUMN_MAP=Users.FullName:display_name,Orders.CustID:customer_id
BATCH_SIZE=5000
TRUNCATE_TARGET=false     # true = empty target tables first (TRUNCATE ... RESTART IDENTITY)
ROW_FALLBACK=true         # if a bulk COPY fails, retry row by row and skip/log bad rows
RESET_SEQUENCES=true      # sync identity/serial sequences after loading
LOG_ROW_VALUES=true       # include failing row values in the log (set false for sensitive data)
LOG_FILE=migration_errors.log

